         if: always() && steps.capture.outputs.upload_allowed == 'true'
         uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
         with:
           name: cat-real-client-capture-${{ github.run_id }}-${{ github.run_attempt }}
           path: ${{ github.workspace }}/cat-client-${{ github.run_id }}-${{ github.run_attempt }}/evidence
           retention-days: 1
           if-no-files-found: error
           include-hidden-files: false
       - name: Actual source build receipt and candidate JAR
         if: always() && steps.build.outputs.upload_allowed == 'true'
         uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
         with:
           name: cat-client-source-${{ github.run_id }}-${{ github.run_attempt }}
           path: ${{ runner.temp }}/cat-client-source/evidence
           retention-days: 1
           if-no-files-found: error
           include-hidden-files: false
