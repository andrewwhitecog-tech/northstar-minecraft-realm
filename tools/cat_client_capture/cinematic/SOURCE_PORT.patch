+                    sink.write(frame.data()); // Exactly ONE actual frame, now sequential disk rather than live encoder pipe.
+                    long elapsed=System.nanoTime()-writeStart;sinkWriteNanos.addAndGet(elapsed);maxSinkWriteNanos.accumulateAndGet(elapsed,Math::max);sinkWriteCalls.incrementAndGet();sinkBytes.addAndGet(frame.data().length);
